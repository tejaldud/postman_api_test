    {
      "name": "5. GitHub Rate Limit Handling",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Set up rate limit handling",
              "pm.variables.set(\"maxRetries\", 3);",
              "pm.variables.set(\"currentRetry\", 0);",
              "pm.variables.set(\"retryDelay\", 1000); // 1 second",
              "",
              "// Check if we're in a retry loop",
              "if (!pm.variables.get(\"isRetrying\")) {",
              "    console.log(\"Initial request - not in retry mode\");",
              "    pm.variables.set(\"isRetrying\", false);",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Capture current rate limit info",
              "console.log(\"Rate limit remaining:\", pm.response.headers.get(\"X-RateLimit-Remaining\"));",
              "console.log(\"Rate limit reset at:\", new Date(parseInt(pm.response.headers.get(\"X-RateLimit-Reset\")) * 1000).toLocaleString());",
              "",
              "// Handle potential rate limiting",
              "if (pm.response.code === 429) { // Too Many Requests",
              "    let currentRetry = parseInt(pm.variables.get(\"currentRetry\"));",
              "    let maxRetries = parseInt(pm.variables.get(\"maxRetries\"));",
              "    ",
              "    if (currentRetry < maxRetries) {",
              "        // Increment retry counter",
              "        currentRetry++;",
              "        pm.variables.set(\"currentRetry\", currentRetry);",
              "        ",
              "        // Set flag to indicate we're retrying",
              "        pm.variables.set(\"isRetrying\", true);",
              "        ",
              "        // Calculate backoff time (exponential backoff)",
              "        let delay = parseInt(pm.variables.get(\"retryDelay\")) * Math.pow(2, currentRetry - 1);",
              "        console.log(`Rate limited. Retrying in ${delay}ms (Attempt ${currentRetry} of ${maxRetries})`);",
              "        ",
              "        // Use setTimeout to retry after delay",
              "        setTimeout(function() {",
              "            // Retry the same request",
              "            pm.sendRequest(pm.request, function (err, res) {",
              "                if (err) {",
              "                    console.error(\"Retry failed:\", err);",
              "                } else {",
              "                    console.log(\"Retry successful:\", res.code);",
              "                    // Process the successful retry response here",
              "                }",
              "            });",
              "        }, delay);",
              "    } else {",
              "        console.log(\"Maximum retries reached. Giving up.\");",
              "        pm.variables.set(\"isRetrying\", false);",
              "        pm.variables.set(\"currentRetry\", 0);",
              "    }",
              "} else {",
              "    // No rate limiting, reset retry counter",
              "    pm.variables.set(\"isRetrying\", false);",
              "    pm.variables.set(\"currentRetry\", 0);",
              "    ",
              "    // Normal test execution",
              "    pm.test(\"Status code is 200\", function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "    ",
              "    pm.test(\"Rate limit information is present\", function () {",
              "        var jsonData = pm.response.json();",
              "        pm.expect(jsonData).to.have.property('resources');",
              "        pm.expect(jsonData.resources).to.have.property('core');",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.github.com/rate_limit",
          "protocol": "https",
          "host": ["api", "github", "com"],
          "path": ["rate_limit"]
        },
        "description": "Request to demonstrate handling of rate limiting with automatic retries and exponential backoff"
      },
      "response": []
    },
    {
      "name": "6. OAuth 2.0 - GitHub User Info",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Validate successful authentication",
              "pm.test(\"Status code is 200 (authenticated)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Validate user info is returned",
              "pm.test(\"User data contains expected fields\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('login');",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('avatar_url');",
              "});",
              "",
              "// Document OAuth setup",
              "console.log(\"OAuth 2.0 Configuration Steps:\");",
              "console.log(\"1. Created GitHub OAuth App\");",
              "console.log(\"2. Configured callback URL to Postman's OAuth handler\");",
              "console.log(\"3. Added Client ID and Secret\");",
              "console.log(\"4. Requested 'user' scope\");",
              "console.log(\"5. Initiated auth flow and acquired token\");"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Debug authentication token",
              "console.log('Using GitHub token: ' + pm.environment.get('github_access_token').substring(0, 4) + '...');",
              "console.log('Token length: ' + pm.environment.get('github_access_token').length);",
              "",
              "// Add custom authorization header",
              "pm.request.headers.upsert({",
              "    key: 'Authorization',",
              "    value: 'token ' + pm.environment.get('github_access_token')",
              "});",
              "",
              "// Add a custom User-Agent header which can help with some API issues",
              "pm.request.headers.upsert({",
              "    key: 'User-Agent',",
              "    value: 'PostmanRuntime'",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.github.com/user",
          "protocol": "https",
          "host": ["api", "github", "com"],
          "path": ["user"]
        },
        "description": "Get authenticated user information from GitHub API using a personal access token"
      },
      "response": []
